# Copy to .env to override the local demo defaults. No .env file is required.
POSTGRES_DB=school360
POSTGRES_USER=school360
POSTGRES_PASSWORD=school360-local
POSTGRES_PORT=5433
APP_PORT=3000
ADMIN_PASSWORD=school360-demo-admin

# The deterministic Hindi intent engine and browser speech features need no API key.
# Optional future integrations can be configured here; they are not required.
# OPENAI_API_KEY=
